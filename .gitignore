# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
/build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtualenvs
.venv/
venv/
ENV/

# Secrets / local env (never commit)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# OS / editor junk
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/
*.code-workspace

# Font build artifacts — ignore everything under build/, then keep preview PNGs
fonts/*/build/**
!fonts/*/build/previews/
!fonts/*/build/previews/**
fonts/*/build/previews/**
!fonts/*/build/previews/**/*.png

# Compiled fonts if dropped outside fonts/*/build/
*.otf
*.ttf
*.woff
*.woff2

# UFO packages (directories) anywhere
*.ufo/
